# Copy to .env to override the defaults. `npm start` and `npm run dev` load it automatically.

# Port the Express API listens on.
PORT=3000

# Base URL of the Flask ML service.
ML_SERVICE_URL=http://127.0.0.1:5001

# Comma-separated browser origins allowed by CORS. Remove the line to allow any origin.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
